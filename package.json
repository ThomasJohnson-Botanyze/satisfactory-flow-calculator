{
  "name": "satisfactory-flow-calculator",
  "version": "2.11.0",
  "description": "Desktop production-flow planner for Satisfactory with alternate recipes and game-mode cost sliders",
  "main": "src/main.js",
  "author": "tjjr",
  "license": "MIT",
  "scripts": {
    "data": "node scripts/transform-docs.js",
    "data:legacy": "node scripts/transform.js",
    "build:renderer": "esbuild src/renderer.js --bundle --outfile=src/renderer.bundle.js --format=iife --platform=browser --target=es2020",
    "prestart": "npm run build:renderer",
    "start": "electron .",
    "test": "node scripts/unit-test.js && node scripts/ui-test.js && npm run build:renderer && node scripts/bundle-smoke.js",
    "test:unit": "node scripts/unit-test.js",
    "test:ui": "node scripts/ui-test.js",
    "prepackage": "npm install --no-audit --no-fund && npm run build:renderer",
    "package": "electron-packager . SatisfactoryFlowCalculator --platform=win32 --arch=x64 --out \"C:/Users/tjjrj/build-out\" --overwrite --prune=true --icon=src/icon.ico --ignore \"^/\\.claude\" --ignore \"^/\\.git\" --ignore \"^/scripts\" --ignore \"^/marketing\" --ignore \"^/data\" --ignore \"^/assets\" --ignore \"^/BACKLOG\\.md\" --ignore \"^/README\\.md\"",
    "postpackage": "node scripts/verify-build.js \"C:/Users/tjjrj/build-out/SatisfactoryFlowCalculator-win32-x64\"",
    "verify:build": "node scripts/verify-build.js",
    "dist": "electron-builder --win",
    "dist:portable": "electron-builder --win portable"
  },
  "build": {
    "appId": "com.tjjr.satisfactoryflow",
    "productName": "Satisfactory Flow Calculator",
    "directories": {
      "output": "C:/Users/tjjrj/build-out/satisfactory-flow"
    },
    "files": [
      "src/**/*",
      "package.json"
    ],
    "win": {
      "icon": "src/icon.ico",
      "target": [
        "nsis",
        "portable"
      ],
      "artifactName": "SatisfactoryFlowCalculator-${version}-${arch}.${ext}"
    },
    "nsis": {
      "oneClick": false,
      "perMachine": false,
      "allowToChangeInstallationDirectory": true,
      "createDesktopShortcut": true
    }
  },
  "devDependencies": {
    "@electron/packager": "^20.0.0",
    "electron": "^33.0.0",
    "electron-builder": "^25.1.8",
    "esbuild": "^0.28.0",
    "jsdom": "^29.1.1"
  },
  "dependencies": {
    "@etothepii/satisfactory-file-parser": "^4.1.1",
    "javascript-lp-solver": "^1.0.3"
  }
}
